*,
*::before,
*::after {
    box-sizing: border-box;
}

.pandit-login-page,
.pandit-page {
    background:
        radial-gradient(circle at top left, rgba(255, 231, 161, 0.44), transparent 34%),
        linear-gradient(180deg, #fff9e9 0%, var(--brown) 52%, #f8ead0 100%);
    color: var(--cream);
    overflow-x: hidden;
}

.pandit-login-page {
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 64px 16px;
}

.pandit-login-panel {
    width: min(100%, 680px);
    border: 1px solid rgba(199, 141, 34, 0.24);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.66);
    box-shadow: 0 30px 80px -54px rgba(63, 36, 23, 0.7);
    padding: 46px;
    text-align: center;
}

.pandit-login-panel h1,
.pandit-hero h1,
.pandit-form-card h2,
.pandit-dashboard-heading h1,
.pandit-session-card h2 {
    font-family: "Cinzel", serif;
    letter-spacing: 0;
}

.pandit-login-panel h1 {
    max-width: 560px;
    margin: 16px auto 12px;
    font-size: clamp(34px, 6vw, 58px);
    line-height: 1.08;
}

.pandit-login-panel p,
.pandit-hero p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
}

.pandit-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(199, 141, 34, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.56);
    color: #9b4c14;
    font-size: 12px;
    font-weight: 800;
    padding: 9px 14px;
    text-transform: uppercase;
}

.pandit-primary-btn,
.pandit-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--saffron), var(--saffron-dark));
    color: #fff;
    font-weight: 800;
    box-shadow: 0 16px 34px -18px rgba(232, 91, 33, 0.8);
}

.pandit-primary-btn {
    margin-top: 18px;
    min-height: 52px;
    padding: 0 24px;
}

.pandit-primary-btn:hover {
    color: #fff;
    background: linear-gradient(135deg, #f06a30, #c84218);
}

.pandit-hero {
    padding: 62px 12px 30px;
}

.pandit-hero h1 {
    max-width: 860px;
    margin-top: 18px;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.1;
}

.pandit-hero p {
    max-width: 720px;
}

.pandit-form-section {
    padding: 22px 12px 70px;
}

.pandit-form {
    display: grid;
    gap: 22px;
    width: 100%;
    max-width: 100%;
}

.pandit-form-card {
    border: 1px solid rgba(199, 141, 34, 0.24);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 22px 70px -58px rgba(63, 36, 23, 0.65);
    overflow: hidden;
    padding: 28px;
}

.pandit-form-card h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--cream);
    font-size: 25px;
    margin-bottom: 20px;
}

.pandit-form-card h2 i,
.pandit-note {
    color: var(--gold);
}

.pandit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    min-width: 0;
}

.pandit-span-2 {
    grid-column: span 2;
}

.pandit-form label,
.pandit-dashboard-form label {
    display: block;
    min-width: 0;
    color: rgba(55, 32, 22, 0.9);
    font-size: 13px;
    font-weight: 800;
}

.pandit-form input,
.pandit-form select,
.pandit-form textarea {
    width: 100%;
    border: 1px solid rgba(199, 141, 34, 0.26);
    border-radius: 14px;
    background: rgba(251, 244, 223, 0.72);
    color: var(--cream);
    font: inherit;
    font-weight: 500;
    margin-top: 8px;
    min-height: 48px;
    padding: 11px 14px;
}

.pandit-form textarea {
    resize: vertical;
}

.pandit-form input:focus,
.pandit-form select:focus,
.pandit-form textarea:focus {
    border-color: rgba(232, 91, 33, 0.58);
    box-shadow: 0 0 0 4px rgba(232, 91, 33, 0.1);
    outline: none;
}

.pandit-chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.pandit-chip {
    position: relative;
    display: inline-flex;
    cursor: pointer;
}

.pandit-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.pandit-chip span {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    border: 1px solid rgba(199, 141, 34, 0.28);
    border-radius: 999px;
    background: rgba(251, 244, 223, 0.68);
    color: rgba(55, 32, 22, 0.86);
    padding: 9px 15px;
    transition: all 0.18s ease;
    white-space: nowrap;
}

.pandit-chip input:checked + span {
    border-color: transparent;
    background: linear-gradient(135deg, rgba(199, 141, 34, 0.96), rgba(232, 91, 33, 0.96));
    color: #fff;
    box-shadow: 0 12px 24px -18px rgba(232, 91, 33, 0.9);
}

.pandit-note {
    border: 1px solid rgba(199, 141, 34, 0.22);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.52);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 18px;
    padding: 12px 14px;
}

.pandit-declarations {
    display: grid;
    gap: 12px;
}

.pandit-declarations label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border: 1px solid rgba(199, 141, 34, 0.2);
    border-radius: 14px;
    background: rgba(251, 244, 223, 0.5);
    padding: 12px 14px;
}

.pandit-declarations input {
    width: 18px;
    min-height: 18px;
    margin-top: 1px;
}

.pandit-submit-btn {
    width: 100%;
    min-height: 56px;
    margin-top: 22px;
    padding: 0 22px;
}

.pandit-dashboard-body {
    margin: 0;
    background: #fff7e4;
    color: var(--cream);
    font-family: "Inter", sans-serif;
    overflow-x: hidden;
}

.pandit-dashboard-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    min-height: 100vh;
    width: 100%;
    align-items: start;
}

.pandit-sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid rgba(199, 141, 34, 0.2);
    background: linear-gradient(180deg, #fff3d0, #fbf4df);
    padding: 24px 18px;
    z-index: 12;
}

.pandit-dashboard-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
}

.pandit-sidebar nav {
    display: grid;
    gap: 6px;
}

.pandit-sidebar nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 14px;
    color: rgba(55, 32, 22, 0.78);
    font-size: 14px;
    font-weight: 800;
    padding: 12px 13px;
}

.pandit-nav-form {
    margin: 0;
}

.pandit-nav-form button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 0;
    border-radius: 14px;
    background: none;
    color: rgba(55, 32, 22, 0.78);
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    padding: 12px 13px;
    text-align: left;
}

.pandit-sidebar nav a.active,
.pandit-sidebar nav a:hover,
.pandit-nav-form button:hover {
    background: rgba(232, 91, 33, 0.1);
    color: var(--saffron-dark);
}

.pandit-dashboard-main {
    min-width: 0;
    width: 100%;
    overflow: hidden;
}

.pandit-topbar {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(199, 141, 34, 0.18);
    background: rgba(255, 249, 233, 0.86);
    backdrop-filter: blur(16px);
    padding: 14px 28px;
    position: sticky;
    top: 0;
    z-index: 5;
}

.pandit-menu-toggle {
    display: none;
}

.pandit-menu-button,
.pandit-mobile-brand {
    display: none;
}

.pandit-topbar-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
    flex-wrap: wrap;
}

.pandit-icon-button {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(199, 141, 34, 0.26);
    border-radius: 50%;
    background: #fff;
    color: var(--saffron-dark);
    position: relative;
    text-decoration: none;
}

.pandit-icon-button span {
    min-width: 18px;
    height: 18px;
    align-items: center;
    background: var(--saffron);
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-size: 10px;
    font-weight: 900;
    justify-content: center;
    padding: 0 5px;
    position: absolute;
    right: -3px;
    top: -4px;
}

.pandit-topbar-logout {
    margin: 0;
}

.pandit-topbar-profile img {
    width: 46px;
    height: 46px;
    border: 2px solid rgba(199, 141, 34, 0.42);
    border-radius: 50%;
    object-fit: cover;
}

.pandit-topbar-profile strong,
.pandit-topbar-profile span {
    display: block;
}

.pandit-topbar-profile strong {
    font-size: 14px;
}

.pandit-topbar-profile span {
    color: var(--saffron-dark);
    font-size: 12px;
    font-weight: 800;
}

.pandit-dashboard-content {
    padding: 28px;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

.pandit-dashboard-heading,
.pandit-page-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 24px;
}

.pandit-dashboard-heading p {
    color: var(--gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.14em;
    margin: 0 0 6px;
    text-transform: uppercase;
}

.pandit-dashboard-heading h1 {
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.12;
    margin: 0;
}

.pandit-dashboard-heading > span {
    border: 1px solid rgba(199, 141, 34, 0.26);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    color: #9b4c14;
    flex: 0 0 auto;
    font-size: 13px;
    font-weight: 800;
    padding: 10px 14px;
}

.pandit-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.pandit-dashboard-meta-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
}

.pandit-stat-card,
.pandit-session-card,
.pandit-mini-card {
    border: 1px solid rgba(199, 141, 34, 0.22);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 20px 60px -54px rgba(63, 36, 23, 0.7);
}

.pandit-stat-card {
    padding: 20px;
}

.pandit-mini-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    color: var(--cream);
    padding: 16px;
}

.pandit-mini-card:hover {
    color: var(--cream);
    transform: translateY(-1px);
}

.pandit-stat-card i,
.pandit-session-icon,
.pandit-mini-card i {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--gold), var(--saffron));
    color: #fff;
}

.pandit-stat-card span {
    display: block;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
    margin-top: 16px;
}

.pandit-stat-card strong {
    display: block;
    color: var(--cream);
    font-family: "Cinzel", serif;
    font-size: 30px;
    margin-top: 4px;
}

.pandit-mini-card span {
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
}

.pandit-mini-card strong {
    color: var(--cream);
    font-family: "Cinzel", serif;
    font-size: 26px;
}

.pandit-session-card {
    margin-top: 20px;
    max-width: 760px;
    padding: 24px;
}

.pandit-session-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

.pandit-session-label {
    color: var(--gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.pandit-session-card h2 {
    font-size: 30px;
    margin: 7px 0 8px;
}

.pandit-session-card p {
    color: var(--muted);
    margin: 0;
}

.pandit-session-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0;
}

.pandit-session-details div {
    border: 1px solid rgba(199, 141, 34, 0.18);
    border-radius: 14px;
    background: rgba(251, 244, 223, 0.58);
    padding: 14px;
}

.pandit-session-details span,
.pandit-session-details strong {
    display: block;
}

.pandit-session-details span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
}

.pandit-session-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.pandit-session-actions button,
.pandit-session-actions a,
.pandit-muted-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(232, 91, 33, 0.32);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #9b4c14;
    font-weight: 800;
    min-height: 44px;
    padding: 0 18px;
}

.pandit-session-actions button.primary,
.pandit-session-actions a.primary {
    border: 0;
    background: linear-gradient(135deg, var(--saffron), var(--saffron-dark));
    color: #fff;
}

.pandit-muted-action {
    color: var(--muted);
}

.pandit-booking-panel {
    max-width: 100%;
}

.pandit-booking-list {
    display: grid;
    gap: 12px;
}

.pandit-booking-section {
    margin-top: 18px;
}

.pandit-booking-section h3 {
    color: var(--cream);
    font-family: "Cinzel", serif;
    font-size: 20px;
    letter-spacing: 0;
    margin: 0 0 10px;
}

.pandit-booking-row {
    display: grid;
    grid-template-columns: minmax(190px, 1.3fr) repeat(6, minmax(90px, 0.8fr)) minmax(150px, 1fr);
    align-items: center;
    gap: 14px;
    border: 1px solid rgba(199, 141, 34, 0.18);
    border-radius: 16px;
    background: rgba(251, 244, 223, 0.5);
    padding: 14px;
}

.pandit-booking-row h3 {
    color: var(--cream);
    font-size: 16px;
    margin: 9px 0 5px;
}

.pandit-booking-row p,
.pandit-booking-row span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    margin: 0;
}

.pandit-booking-row strong {
    color: var(--cream);
    display: block;
    font-size: 13px;
    margin-top: 5px;
}

.pandit-booking-row form {
    margin: 0;
}

.pandit-booking-actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
}

