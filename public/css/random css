    .pandit-booking-row {
        grid-template-columns: 1fr;
    }
}

.pandit-booking-actions .pandit-muted-action {
    white-space: nowrap;
    width: auto;
    flex: 0 0 auto;
}

@media (max-width: 575px) {
    .pandit-booking-actions .pandit-muted-action {
        width: 100%;
    }
}