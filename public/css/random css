.pandit-booking-row button.primary,
.pandit-booking-row button.secondary,
.pandit-booking-row a.primary,
.pandit-booking-row a.secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--saffron), var(--saffron-dark));
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
}




