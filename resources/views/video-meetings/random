        <script>
            document.addEventListener('DOMContentLoaded', function () {
                document
                    .querySelectorAll('[data-video-meeting-sdk]')
                    .forEach(function (panel) {
                        /*
                        |--------------------------------------------------------------------------
                        | Device / view selection
                        |--------------------------------------------------------------------------
                        |
                        | Decide once. Never swap Component View <-> Client View while
                        | an active meeting is running.
                        |
                        */

                        const userAgent = navigator.userAgent || '';

                        const isIOS =
                            /iPhone|iPad|iPod/i.test(userAgent)
                            || (
                                navigator.platform === 'MacIntel'
                                && navigator.maxTouchPoints > 1
                            );

                        const isAndroid =
                            /Android/i.test(userAgent);

                        const coarsePointer =
                            window.matchMedia('(pointer: coarse)').matches;

                        const smallScreen =
                            window.matchMedia('(max-width: 991.98px)').matches;

                        const tabletTouchDevice =
                            coarsePointer
                            && window.innerWidth <= 1366;

                        const mobileClientUrl =
                            panel.dataset.mobileClientUrl || '';

                        /*
                         * Only use Client View when its route actually exists.
                         * Otherwise safely fall back to Component View.
                         */
                        const useClientView =
                            Boolean(mobileClientUrl)
                            && (
                                isIOS
                                || isAndroid
                                || smallScreen
                                || tabletTouchDevice
                            );

                        panel.dataset.zoomMode =
                            useClientView ? 'mobile' : 'desktop';


                        /*
                        |--------------------------------------------------------------------------
                        | Tablet / Mobile Client View
                        |--------------------------------------------------------------------------
                        */

                        if (useClientView) {
                            const button =
                                panel.querySelector('[data-mobile-zoom-start]');

                            const frame =
                                panel.querySelector('[data-mobile-zoom-frame]');

                            const wrapper =
                                panel.querySelector('[data-mobile-zoom-wrap]');

                            const message =
                                panel.querySelector('[data-mobile-zoom-message]');

                            if (!button || !frame || !wrapper) {
                                return;
                            }

                            button.addEventListener('click', function () {
                                /*
                                 * Load once, only after a user gesture.
                                 */
                                if (!frame.getAttribute('src')) {
                                    frame.src = mobileClientUrl;
                                }

                                wrapper.hidden = false;
                                button.style.display = 'none';

                                if (message) {
                                    message.textContent =
                                        'Opening Zoom meeting...';
                                }
                            });

                            return;
                        }


                        /*
                        |--------------------------------------------------------------------------
                        | Desktop Component View
                        |--------------------------------------------------------------------------
                        */

                        const startButton =
                            panel.querySelector('[data-desktop-zoom-start]');

                        const root =
                            panel.querySelector('[data-sdk-root]');

                        const widthLock =
                            panel.querySelector('[data-zoom-width-lock]');

                        const message =
                            panel.querySelector('[data-desktop-zoom-message]');

                        if (!startButton || !root || !widthLock) {
                            return;
                        }

                        let client = null;
                        let resizeTimer = null;
                        let resizeListener = null;

                        const setMessage = function (
                            text,
                            isError = false
                        ) {
                            if (!message) {
                                return;
                            }

                            message.textContent = text;

                            message.classList.toggle(
                                'error',
                                Boolean(isError)
                            );

                            message.hidden = false;
                        };


                        /*
                        |--------------------------------------------------------------------------
                        | Dynamic script loader
                        |--------------------------------------------------------------------------
                        */

                        const loadScript = function (src) {
                            return new Promise(function (
                                resolve,
                                reject
                            ) {
                                const existing =
                                    document.querySelector(
                                        'script[src="' + src + '"]'
                                    );

                                if (existing) {
                                    if (
                                        existing.dataset.bdLoaded === 'true'
                                        || existing.readyState === 'complete'
                                    ) {
                                        resolve();
                                        return;
                                    }

                                    existing.addEventListener(
                                        'load',
                                        resolve,
                                        { once: true }
                                    );

                                    existing.addEventListener(
                                        'error',
                                        reject,
                                        { once: true }
                                    );

                                    return;
                                }

                                const script =
                                    document.createElement('script');

                                script.src = src;

                                script.onload = function () {
                                    script.dataset.bdLoaded = 'true';
                                    resolve();
                                };

                                script.onerror = function () {
                                    reject(
                                        new Error(
                                            'Zoom SDK script failed to load.'
                                        )
                                    );
                                };

                                document.body.appendChild(script);
                            });
                        };


                        const loadDesktopSDK = async function () {
                            const version =
                                @json($zoomSdkVersion);

                            const base =
                                'https://source.zoom.us/' + version;

                            await loadScript(
                                base + '/lib/vendor/react.min.js'
                            );

                            await loadScript(
                                base + '/lib/vendor/react-dom.min.js'
                            );

                            await loadScript(
                                base + '/lib/vendor/redux.min.js'
                            );

                            await loadScript(
                                base + '/lib/vendor/redux-thunk.min.js'
                            );

                            await loadScript(
                                base + '/lib/vendor/lodash.min.js'
                            );

                            await loadScript(
                                base
                                + '/zoom-meeting-embedded-'
                                + version
                                + '.min.js'
                            );
                        };


                        /*
                        |--------------------------------------------------------------------------
                        | STABLE Zoom size
                        |--------------------------------------------------------------------------
                        |
                        | THIS FIXES THE GALLERY WIDTH RUNAWAY.
                        |
                        | Old behavior:
                        | Gallery grows -> ResizeObserver fires -> new larger width is sent
                        | to Zoom -> Gallery grows again -> observer fires again...
                        |
                        | New behavior:
                        | - No ResizeObserver.
                        | - Width comes only from this stable BhaktiDeep shell.
                        | - Gallery/Speaker view changes cannot trigger a width update.
                        | - updateVideoOptions only runs when the BROWSER WINDOW resizes.
                        |
                        */

                        const getStableZoomSize = function () {
                            const rect =
                                widthLock.getBoundingClientRect();

                            const availableWidth =
                                Math.floor(rect.width);

                            /*
                             * Component View is desktop-only here.
                             * Keep it inside the BhaktiDeep shell.
                             */
                            const width =
                                Math.min(
                                    1440,
                                    Math.max(
                                        720,
                                        availableWidth
                                    )
                                );

                            /*
                             * Reserve ~100px vertically for Zoom controls.
                             * Do not give the whole root height to video.
                             */
                            const rootHeight =
                                Math.max(
                                    700,
                                    Math.floor(
                                        root.getBoundingClientRect().height
                                        || 700
                                    )
                                );

                            const maxVideoHeight =
                                Math.max(
                                    411,
                                    rootHeight - 105
                                );

                            const naturalHeight =
                                Math.round(
                                    width * 9 / 16
                                );

                            const height =
                                Math.min(
                                    590,
                                    maxVideoHeight,
                                    Math.max(
                                        411,
                                        naturalHeight
                                    )
                                );

                            return {
                                width: width,
                                height: height,
                            };
                        };


                        /*
                        |--------------------------------------------------------------------------
                        | Browser-window resize only
                        |--------------------------------------------------------------------------
                        |
                        | IMPORTANT:
                        | No ResizeObserver is used here. This prevents Gallery View
                        | from triggering the feedback loop that kept increasing width.
                        |
                        */

                        const resizeZoomForWindow = function () {
                            if (
                                !client
                                || typeof client.updateVideoOptions !== 'function'
                            ) {
                                return;
                            }

                            clearTimeout(resizeTimer);

                            resizeTimer =
                                setTimeout(function () {
                                    const size =
                                        getStableZoomSize();

                                    Promise
                                        .resolve(
                                            client.updateVideoOptions({
                                                viewSizes: {
                                                    default: {
                                                        width: size.width,
                                                        height: size.height,
                                                    },

                                                    ribbon: {
                                                        width: 300,
                                                        height: Math.min(
                                                            520,
                                                            size.height
                                                        ),
                                                    },
                                                },
                                            })
                                        )
                                        .catch(function (error) {
                                            console.warn(
                                                'Zoom window resize:',
                                                error
                                            );
                                        });
                                }, 180);
                        };


                        /*
                        |--------------------------------------------------------------------------
                        | Start desktop meeting
                        |--------------------------------------------------------------------------
                        */

                        startButton.addEventListener(
                            'click',
                            async function () {
                                if (
                                    panel.dataset.sdkStarted === 'true'
                                ) {
                                    return;
                                }

                                panel.dataset.sdkStarted = 'true';
                                startButton.disabled = true;

                                setMessage(
                                    'Preparing Zoom meeting...'
                                );

                                try {
                                    await loadDesktopSDK();

                                    if (!window.ZoomMtgEmbedded) {
                                        throw new Error(
                                            'Zoom Component View could not load.'
                                        );
                                    }


                                    /*
                                    |--------------------------------------------------------------------------
                                    | Fetch Laravel SDK config
                                    |--------------------------------------------------------------------------
                                    */

                                    const response =
                                        await fetch(
                                            panel.dataset.sdkEndpoint,
                                            {
                                                method: 'POST',

                                                headers: {
                                                    'Accept':
                                                        'application/json',

                                                    'Content-Type':
                                                        'application/json',

                                                    'X-CSRF-TOKEN':
                                                        panel.dataset.csrfToken,
                                                },

                                                credentials:
                                                    'same-origin',
                                            }
                                        );

                                    if (!response.ok) {
                                        const body =
                                            await response
                                                .json()
                                                .catch(
                                                    () => ({})
                                                );

                                        throw new Error(
                                            body.message
                                            || 'Unable to prepare meeting.'
                                        );
                                    }

                                    const config =
                                        await response.json();

                                    if (
                                        config.provider !== 'zoom'
                                    ) {
                                        throw new Error(
                                            'Zoom provider unavailable.'
                                        );
                                    }


                                    /*
                                    |--------------------------------------------------------------------------
                                    | Create Component View client
                                    |--------------------------------------------------------------------------
                                    */

                                    client =
                                        window.ZoomMtgEmbedded
                                            .createClient();

                                    const size =
                                        getStableZoomSize();


                                    /*
                                    |--------------------------------------------------------------------------
                                    | Init
                                    |--------------------------------------------------------------------------
                                    |
                                    | We DO NOT force Gallery here.
                                    |
                                    | User can choose Ribbon / Speaker / Gallery.
                                    | Gallery will keep the SAME width because there is no
                                    | ResizeObserver feedback loop anymore.
                                    |
                                    */

                                    await client.init({
                                        zoomAppRoot: root,

                                        language: 'en-US',

                                        patchJsMedia: true,

                                        customize: {
                                            video: {
                                                /*
                                                 * Manual resize stays available.
                                                 */
                                                isResizable: true,

                                                /*
                                                 * Complete Zoom video window cannot be
                                                 * dragged around BhaktiDeep.
                                                 */
                                                popper: {
                                                    disableDraggable: true,
                                                },

                                                viewSizes: {
                                                    /*
                                                     * Gallery / Speaker
                                                     */
                                                    default: {
                                                        width: size.width,
                                                        height: size.height,
                                                    },

                                                    /*
                                                     * Ribbon is intentionally narrow.
                                                     */
                                                    ribbon: {
                                                        width: 300,
                                                        height: Math.min(
                                                            520,
                                                            size.height
                                                        ),
                                                    },
                                                },
                                            },
                                        },
                                    });


                                    /*
                                    |--------------------------------------------------------------------------
                                    | Join
                                    |--------------------------------------------------------------------------
                                    */

                                    const joinConfig = {
                                        signature:
                                            config.signature,

                                        meetingNumber:
                                            config.meetingNumber,

                                        password:
                                            config.password || '',

                                        userName:
                                            config.userName,

                                        userEmail:
                                            config.userEmail || '',
                                    };

                                    if (config.zak) {
                                        joinConfig.zak =
                                            config.zak;
                                    }

                                    await client.join(
                                        joinConfig
                                    );


                                    /*
                                    |--------------------------------------------------------------------------
                                    | Safe responsive update
                                    |--------------------------------------------------------------------------
                                    |
                                    | Only actual browser resizing can trigger this.
                                    | Gallery/Speaker/Ribbon switching cannot.
                                    |
                                    */

                                    resizeListener =
                                        resizeZoomForWindow;

                                    window.addEventListener(
                                        'resize',
                                        resizeListener,
                                        { passive: true }
                                    );


                                    setMessage(
                                        'Zoom meeting is running inside BhaktiDeep.'
                                    );

                                } catch (error) {
                                    console.error(
                                        'Zoom Error:',
                                        error
                                    );

                                    panel.dataset.sdkStarted =
                                        'false';

                                    startButton.disabled =
                                        false;

                                    if (resizeListener) {
                                        window.removeEventListener(
                                            'resize',
                                            resizeListener
                                        );

                                        resizeListener =
                                            null;
                                    }

                                    setMessage(
                                        error?.message
                                        || 'Unable to open Zoom meeting.',
                                        true
                                    );
                                }
                            }
                        );
                    });


                /*
                |--------------------------------------------------------------------------
                | Mobile Client View leave event
                |--------------------------------------------------------------------------
                */

                window.addEventListener(
                    'message',
                    function (event) {
                        if (
                            event.origin !==
                            window.location.origin
                        ) {
                            return;
                        }

                        if (
                            event.data?.type !==
                            'bhaktideep:zoom-left'
                        ) {
                            return;
                        }

                        document
                            .querySelectorAll(
                                '[data-video-meeting-sdk]'
                            )
                            .forEach(function (panel) {
                                const frame =
                                    panel.querySelector(
                                        '[data-mobile-zoom-frame]'
                                    );

                                const wrapper =
                                    panel.querySelector(
                                        '[data-mobile-zoom-wrap]'
                                    );

                                const button =
                                    panel.querySelector(
                                        '[data-mobile-zoom-start]'
                                    );

                                const message =
                                    panel.querySelector(
                                        '[data-mobile-zoom-message]'
                                    );

                                if (frame) {
                                    frame.src =
                                        'about:blank';
                                }

                                if (wrapper) {
                                    wrapper.hidden =
                                        true;
                                }

                                if (button) {
                                    button.style.display =
                                        '';
                                }

                                if (message) {
                                    message.textContent =
                                        'You left the Zoom meeting.';
                                }
                            });
                    }
                );
            });
        </script>
