        <script>
            document.addEventListener(
                'DOMContentLoaded',
                function() {


                    document
                        .querySelectorAll(
                            '[data-video-meeting-sdk]'
                        )
                        .forEach(
                            function(
                                panel
                            ) {


                                /*
                                |--------------------------------------------------------------------------
                                | DEVICE DETECTION
                                |--------------------------------------------------------------------------
                                |
                                | Important:
                                | Active meeting ke beech
                                | view switch nahi karenge.
                                |
                                */


                                const userAgent =
                                    navigator.userAgent ||
                                    '';


                                const isIOS =

                                    /iPhone|iPad|iPod/i
                                    .test(
                                        userAgent
                                    )

                                    ||

                                    (navigator.platform ===
                                        'MacIntel'

                                        &&

                                        navigator
                                        .maxTouchPoints >
                                        1);


                                const isAndroid =

                                    /Android/i
                                    .test(
                                        userAgent
                                    );


                                /*
                                 * Touch tablet:
                                 * iPad Pro landscape etc.
                                 */
                                const isTouchTablet =

                                    navigator
                                    .maxTouchPoints >
                                    1

                                    &&

                                    window.innerWidth <=
                                    1366;


                                const smallScreen =

                                    window
                                    .matchMedia(
                                        '(max-width: 1199.98px)'
                                    )
                                    .matches;


                                const useClientView =

                                    isIOS ||
                                    isAndroid ||
                                    isTouchTablet ||
                                    smallScreen;


                                /*
                                 * Decide ONCE.
                                 */
                                panel.dataset.zoomMode =

                                    useClientView ?
                                    'mobile' :
                                    'desktop';



                                /*
                                |--------------------------------------------------------------------------
                                | MOBILE / TABLET
                                |--------------------------------------------------------------------------
                                */

                                if (
                                    useClientView
                                ) {


                                    const button =
                                        panel
                                        .querySelector(
                                            '[data-mobile-zoom-start]'
                                        );


                                    const frame =
                                        panel
                                        .querySelector(
                                            '[data-mobile-zoom-frame]'
                                        );


                                    const message =
                                        panel
                                        .querySelector(
                                            '[data-mobile-zoom-message]'
                                        );


                                    if (
                                        !button ||
                                        !frame
                                    ) {

                                        return;

                                    }


                                    button
                                        .addEventListener(
                                            'click',
                                            function() {


                                                /*
                                                 * Load iframe only
                                                 * after user click.
                                                 */
                                                if (
                                                    !frame.src
                                                ) {

                                                    frame.src =
                                                        frame.dataset.src;

                                                }


                                                frame
                                                    .closest(
                                                        '[data-mobile-zoom-wrap]'
                                                    )
                                                    ?.removeAttribute(
                                                        'hidden'
                                                    );


                                                button.style.display =
                                                    'none';


                                                if (
                                                    message
                                                ) {

                                                    message.textContent =
                                                        'Opening Zoom meeting...';

                                                }

                                            }
                                        );


                                    return;

                                }



                                /*
                                |--------------------------------------------------------------------------
                                | DESKTOP COMPONENT VIEW
                                |--------------------------------------------------------------------------
                                */

                                const startButton =
                                    panel
                                    .querySelector(
                                        '[data-desktop-zoom-start]'
                                    );


                                const root =
                                    panel
                                    .querySelector(
                                        '[data-sdk-root]'
                                    );


                                const message =
                                    panel
                                    .querySelector(
                                        '[data-desktop-zoom-message]'
                                    );


                                if (
                                    !startButton ||
                                    !root
                                ) {

                                    return;

                                }


                                let client =
                                    null;


                                let resizeObserver =
                                    null;


                                let resizeTimer =
                                    null;



                                const setMessage =
                                    function(
                                        text,
                                        error = false
                                    ) {

                                        if (
                                            !message
                                        ) {

                                            return;

                                        }


                                        message.textContent =
                                            text;


                                        message
                                            .classList
                                            .toggle(
                                                'error',
                                                error
                                            );


                                        message.hidden =
                                            false;

                                    };



                                /*
                                |--------------------------------------------------------------------------
                                | LOAD SCRIPT
                                |--------------------------------------------------------------------------
                                */

                                const loadScript =
                                    function(
                                        src
                                    ) {


                                        return new Promise(
                                            function(
                                                resolve,
                                                reject
                                            ) {


                                                const existing =
                                                    document
                                                    .querySelector(
                                                        'script[src="' +
                                                        src +
                                                        '"]'
                                                    );


                                                if (
                                                    existing
                                                ) {

                                                    resolve();

                                                    return;

                                                }


                                                const script =
                                                    document
                                                    .createElement(
                                                        'script'
                                                    );


                                                script.src =
                                                    src;


                                                script.onload =
                                                    resolve;


                                                script.onerror =
                                                    function() {

                                                        reject(
                                                            new Error(
                                                                'Zoom SDK script load nahi hua.'
                                                            )
                                                        );

                                                    };


                                                document.body
                                                    .appendChild(
                                                        script
                                                    );

                                            }
                                        );

                                    };



                                const loadDesktopSDK =
                                    async function() {


                                        const base =
                                            'https://source.zoom.us/' +
                                            @json($zoomSdkVersion);


                                        await loadScript(
                                            base +
                                            '/lib/vendor/react.min.js'
                                        );


                                        await loadScript(
                                            base +
                                            '/lib/vendor/react-dom.min.js'
                                        );


                                        await loadScript(
                                            base +
                                            '/lib/vendor/redux.min.js'
                                        );


                                        await loadScript(
                                            base +
                                            '/lib/vendor/redux-thunk.min.js'
                                        );


                                        await loadScript(
                                            base +
                                            '/lib/vendor/lodash.min.js'
                                        );


                                        await loadScript(
                                            base +
                                            '/zoom-meeting-embedded-' +
                                            @json($zoomSdkVersion) +
                                            '.min.js'
                                        );

                                    };



                                /*
                                |--------------------------------------------------------------------------
                                | SIZE
                                |--------------------------------------------------------------------------
                                */

                                const getSize =
                                    function() {


                                        const width =
                                            Math.max(
                                                720,
                                                Math.floor(
                                                    root
                                                    .getBoundingClientRect()
                                                    .width
                                                )
                                            );


                                        const height =
                                            Math.min(

                                                720,

                                                Math.max(

                                                    411,

                                                    Math.round(
                                                        width *
                                                        9 /
                                                        16
                                                    )

                                                )

                                            );


                                        return {

                                            width: width,

                                            height: height,

                                        };

                                    };



                                /*
                                |--------------------------------------------------------------------------
                                | RESIZE ZOOM
                                |--------------------------------------------------------------------------
                                */

                                const resizeZoom =
                                    function() {


                                        if (
                                            !client ||
                                            typeof client
                                            .updateVideoOptions !==
                                            'function'
                                        ) {

                                            return;

                                        }


                                        clearTimeout(
                                            resizeTimer
                                        );


                                        resizeTimer =
                                            setTimeout(
                                                function() {


                                                    const size =
                                                        getSize();


                                                    Promise
                                                        .resolve(
                                                            client
                                                            .updateVideoOptions({

                                                                viewSizes: {

                                                                    default: {

                                                                        width: size.width,

                                                                        height: size.height,

                                                                    },

                                                                },

                                                            })
                                                        )
                                                        .catch(
                                                            function(
                                                                error
                                                            ) {

                                                                console.warn(
                                                                    'Zoom resize:',
                                                                    error
                                                                );

                                                            }
                                                        );

                                                },
                                                150
                                            );

                                    };



                                /*
                                |--------------------------------------------------------------------------
                                | START DESKTOP MEETING
                                |--------------------------------------------------------------------------
                                */

                                startButton
                                    .addEventListener(
                                        'click',
                                        async function() {


                                            if (
                                                panel
                                                .dataset
                                                .sdkStarted ===
                                                'true'
                                            ) {

                                                return;

                                            }


                                            panel
                                                .dataset
                                                .sdkStarted =
                                                'true';


                                            startButton
                                                .disabled =
                                                true;


                                            setMessage(
                                                'Preparing Zoom meeting...'
                                            );


                                            try {


                                                /*
                                                 * Load SDK only on
                                                 * desktop.
                                                 */
                                                await loadDesktopSDK();


                                                if (
                                                    !window
                                                    .ZoomMtgEmbedded
                                                ) {

                                                    throw new Error(
                                                        'Zoom Component View load nahi hua.'
                                                    );

                                                }


                                                /*
                                                |--------------------------------------------------------------------------
                                                | GET SIGNATURE
                                                |--------------------------------------------------------------------------
                                                */

                                                const response =
                                                    await fetch(
                                                        panel
                                                        .dataset
                                                        .sdkEndpoint, {

                                                            method: 'POST',

                                                            headers: {

                                                                'Accept': 'application/json',

                                                                'Content-Type': 'application/json',

                                                                'X-CSRF-TOKEN': panel
                                                                    .dataset
                                                                    .csrfToken,

                                                            },

                                                            credentials: 'same-origin',

                                                        }
                                                    );


                                                if (
                                                    !response.ok
                                                ) {

                                                    const body =
                                                        await response
                                                        .json()
                                                        .catch(
                                                            () => ({})
                                                        );


                                                    throw new Error(

                                                        body.message ||
                                                        'Meeting prepare nahi hui.'

                                                    );

                                                }


                                                const config =
                                                    await response
                                                    .json();


                                                if (
                                                    config.provider !==
                                                    'zoom'
                                                ) {

                                                    throw new Error(
                                                        'Zoom provider available nahi hai.'
                                                    );

                                                }



                                                /*
                                                |--------------------------------------------------------------------------
                                                | CREATE CLIENT
                                                |--------------------------------------------------------------------------
                                                */

                                                client =
                                                    window
                                                    .ZoomMtgEmbedded
                                                    .createClient();


                                                const size =
                                                    getSize();



                                                /*
                                                |--------------------------------------------------------------------------
                                                | INIT
                                                |--------------------------------------------------------------------------
                                                */

                                                await client.init({

                                                    zoomAppRoot: root,


                                                    language: 'en-US',


                                                    patchJsMedia: true,


                                                    customize: {

                                                        video: {

                                                            /*
                                                             * USER RESIZE OFF
                                                             */
                                                            isResizable: true,


                                                            /*
                                                             * DRAG OFF
                                                             */
                                                            popper: {

                                                                disableDraggable: false,

                                                            },


                                                            viewSizes: {

                                                                default: {

                                                                    width: size.width,

                                                                    height: size.height,

                                                                },

                                                            },

                                                        },

                                                    },

                                                });



                                                /*
                                                |--------------------------------------------------------------------------
                                                | PROGRAMMATIC RESPONSIVE RESIZE
                                                |--------------------------------------------------------------------------
                                                */

                                                if (
                                                    typeof ResizeObserver !==
                                                    'undefined'
                                                ) {


                                                    resizeObserver =
                                                        new ResizeObserver(
                                                            function() {

                                                                resizeZoom();

                                                            }
                                                        );


                                                    resizeObserver
                                                        .observe(
                                                            root
                                                        );

                                                }



                                                /*
                                                |--------------------------------------------------------------------------
                                                | JOIN
                                                |--------------------------------------------------------------------------
                                                */

                                                const joinConfig = {

                                                    signature: config.signature,


                                                    meetingNumber: config.meetingNumber,


                                                    password: config.password ||
                                                        '',


                                                    userName: config.userName,


                                                    userEmail: config.userEmail ||
                                                        '',

                                                };


                                                /*
                                                 * Only host Pandit.
                                                 */
                                                if (
                                                    config.zak
                                                ) {

                                                    joinConfig.zak =
                                                        config.zak;

                                                }


                                                await client.join(
                                                    joinConfig
                                                );


                                                setMessage(
                                                    'Zoom meeting BhaktiDeep ke andar chal rahi hai.'
                                                );


                                            } catch (
                                                error
                                            ) {


                                                console.error(
                                                    'Zoom Error:',
                                                    error
                                                );


                                                panel
                                                    .dataset
                                                    .sdkStarted =
                                                    'false';


                                                startButton
                                                    .disabled =
                                                    false;


                                                if (
                                                    resizeObserver
                                                ) {

                                                    resizeObserver
                                                        .disconnect();

                                                }


                                                setMessage(

                                                    error?.message ||
                                                    'Zoom meeting open nahi hui.',

                                                    true

                                                );

                                            }

                                        }
                                    );

                            }
                        );



                    /*
                    |--------------------------------------------------------------------------
                    | MOBILE IFRAME LEFT MEETING
                    |--------------------------------------------------------------------------
                    */

                    window
                        .addEventListener(
                            'message',
                            function(
                                event
                            ) {


                                if (
                                    event.origin !==
                                    window.location.origin
                                ) {

                                    return;

                                }


                                if (
                                    event.data?.type !==
                                    'bhaktideep:zoom-left'
                                ) {

                                    return;

                                }


                                document
                                    .querySelectorAll(
                                        '[data-video-meeting-sdk]'
                                    )
                                    .forEach(
                                        function(
                                            panel
                                        ) {


                                            const frame =
                                                panel
                                                .querySelector(
                                                    '[data-mobile-zoom-frame]'
                                                );


                                            const button =
                                                panel
                                                .querySelector(
                                                    '[data-mobile-zoom-start]'
                                                );


                                            const wrapper =
                                                panel
                                                .querySelector(
                                                    '[data-mobile-zoom-wrap]'
                                                );


                                            const message =
                                                panel
                                                .querySelector(
                                                    '[data-mobile-zoom-message]'
                                                );


                                            if (
                                                frame
                                            ) {

                                                frame.src =
                                                    '';

                                            }


                                            if (
                                                wrapper
                                            ) {

                                                wrapper.hidden =
                                                    true;

                                            }


                                            if (
                                                button
                                            ) {

                                                button.style.display =
                                                    '';

                                            }


                                            if (
                                                message
                                            ) {

                                                message.textContent =
                                                    'You left the Zoom meeting.';

                                            }

                                        }
                                    );

                            }
                        );

                }
            );
        </script>
    @endpush
