            'mode' => $isHostMode ? 'host' : 'participant',
        ], fn ($value) => $value !== null && $value !== '')
    );

    $zoomSdkVersion = config(
        'video_meetings.providers.zoom.meeting_sdk_cdn_version',
        '6.2.0'
    );

    $familyToken = request()->route('token');

    $isFamilyMember = isset($activeFamilyInvite)
        && $activeFamilyInvite
        && filled($familyToken);

    /*
    |--------------------------------------------------------------------------
    | Optional Tablet/Mobile Client View URL
    |--------------------------------------------------------------------------
    |
    | GitHub main may not have these routes yet. Route::has() prevents this
    | Blade from crashing until the mobile Client View setup is completed.
    |
    */
    $mobileClientUrl = null;

    if (
        $isFamilyMember
        && \Illuminate\Support\Facades\Route::has('live.family.client')
    ) {
        $mobileClientUrl = route('live.family.client', [
            'token' => $familyToken,
        ]);
    } elseif (
        !$isFamilyMember
        && \Illuminate\Support\Facades\Route::has('live.session.client')
    ) {
