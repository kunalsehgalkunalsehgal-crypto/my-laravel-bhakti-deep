    <meta
        name="csrf-token"
        content="{{ csrf_token() }}"
    >


    <title>
        BhaktiDeep Zoom Meeting
    </title>


    <!-- Zoom Client View CSS -->

    <link
        rel="stylesheet"
        href="https://source.zoom.us/{{ $zoomSdkVersion }}/css/bootstrap.css"
    >

    <link
        rel="stylesheet"
        href="https://source.zoom.us/{{ $zoomSdkVersion }}/css/react-select.css"
    >


    <style>

        html,
        body {

            width: 100%;
            height: 100%;

            margin: 0;
            padding: 0;

            overflow: hidden;

            background: #000;

        }


        #zmmtg-root {

            display: block !important;

        }


        .bd-zoom-loading {

            position: fixed;

            inset: 0;

            z-index: 9999999;

            display: flex;

            align-items: center;
            justify-content: center;

            padding: 24px;

            background: #101010;

            color: white;

            font-family:
                Arial,
                sans-serif;

            text-align: center;

        }


        .bd-zoom-loading.hidden {

            display: none;

        }


        .bd-spinner {

            width: 42px;
            height: 42px;

            margin:
                0 auto 18px;

            border-radius:
                50%;

            border:
                4px solid
                rgba(
                    255,
                    255,
                    255,
                    .20
                );

            border-top-color:
                #fff;

            animation:
                bdZoomSpin
                .8s
                linear
                infinite;

        }


        @keyframes bdZoomSpin {

            to {

                transform:
                    rotate(
                        360deg
                    );

            }

        }


        .bd-zoom-loading strong {

            display: block;

            margin-bottom:
                8px;

            font-size:
                18px;

        }


        .bd-zoom-loading p {

            max-width:
                360px;

            margin: 0;

            color:
                #bbb;

            font-size:
                13px;

            line-height:
                1.5;

        }

    </style>

</head>



<body>


<div
    class="bd-zoom-loading"
    data-zoom-loading
>

    <div>

        <div
            class="bd-spinner">
        </div>


        <strong>
            Opening Zoom Meeting...
        </strong>


        <p
            data-zoom-message
        >
            Camera aur microphone permission
            Allow karein.
        </p>

    </div>

</div>



<!-- Zoom Dependencies -->

<script
    src="https://source.zoom.us/{{ $zoomSdkVersion }}/lib/vendor/react.min.js">
</script>


<script
    src="https://source.zoom.us/{{ $zoomSdkVersion }}/lib/vendor/react-dom.min.js">
</script>


<script
    src="https://source.zoom.us/{{ $zoomSdkVersion }}/lib/vendor/redux.min.js">
</script>


<script
    src="https://source.zoom.us/{{ $zoomSdkVersion }}/lib/vendor/redux-thunk.min.js">
</script>


<script
    src="https://source.zoom.us/{{ $zoomSdkVersion }}/lib/vendor/lodash.min.js">
</script>


<!-- CLIENT VIEW -->

<script
    src="https://source.zoom.us/{{ $zoomSdkVersion }}/zoom-meeting-{{ $zoomSdkVersion }}.min.js">
</script>



<script>

document.addEventListener(
    'DOMContentLoaded',
    async function () {


        const sdkEndpoint =
            @json($sdkEndpointUrl);


        const leaveUrl =
            @json($leaveUrl);


        const sdkVersion =
            @json($zoomSdkVersion);


        const csrfToken =
            @json(csrf_token());


        const loading =
            document.querySelector(
                '[data-zoom-loading]'
            );


        const message =
            document.querySelector(
                '[data-zoom-message]'
            );


        const showError =
            function (
                text
            ) {

                console.error(
                    text
                );


                if (message) {

                    message.textContent =
                        text;

                }

            };


        if (
            !window.ZoomMtg
        ) {

            showError(
                'Zoom Client View SDK load nahi hua.'
            );

            return;

        }


        try {


            /*
            |--------------------------------------------------------------------------
            | GET EXISTING SDK CONFIG
            |--------------------------------------------------------------------------
            */

            const response =
                await fetch(
                    sdkEndpoint,
                    {

                        method:
                            'POST',

                        headers: {

                            'Accept':
                                'application/json',

                            'Content-Type':
                                'application/json',

                            'X-CSRF-TOKEN':
                                csrfToken,

                        },

                        credentials:
                            'same-origin',

                    }
                );


            if (
                !response.ok
            ) {

                const body =
                    await response
                        .json()
                        .catch(
                            () => ({})
                        );


                throw new Error(

                    body.message
                    ||
                    'Zoom meeting prepare nahi ho payi.'

                );

            }


            const config =
                await response.json();


            if (
                config.provider
                !== 'zoom'
            ) {

                throw new Error(
                    'Zoom provider available nahi hai.'
                );

            }


            /*
            |--------------------------------------------------------------------------
            | ZOOM WASM
            |--------------------------------------------------------------------------
            */

            ZoomMtg.setZoomJSLib(

                'https://source.zoom.us/'
                + sdkVersion
                + '/lib',

                '/av'

            );


            ZoomMtg.preLoadWasm();

            ZoomMtg.prepareWebSDK();



            /*
            |--------------------------------------------------------------------------
            | INIT CLIENT VIEW
            |--------------------------------------------------------------------------
            */

            ZoomMtg.init({

                leaveUrl:
                    leaveUrl,


                patchJsMedia:
                    true,


                success:
                    function () {


                        /*
                        |--------------------------------------------------------------------------
                        | JOIN OPTIONS
                        |--------------------------------------------------------------------------
                        */

                        const options = {

                            signature:
                                config.signature,


                            meetingNumber:
                                config.meetingNumber,


                            userName:
                                config.userName,


                            userEmail:
                                config.userEmail
                                || '',


                            /*
                             * Client View uses
                             * passWord
                             */
                            passWord:
                                config.password
                                || '',


                            success:
                                function () {


                                    if (
                                        loading
                                    ) {

                                        loading
                                            .classList
                                            .add(
                                                'hidden'
                                            );

                                    }

                                },


                            error:
                                function (
                                    error
                                ) {

                                    console.error(
                                        'Zoom join error:',
                                        error
                                    );


                                    showError(
                                        'Zoom meeting join nahi ho payi.'
                                    );

                                },

                        };


                        /*
                         * Pandit host ke liye
                         * ZAK.
                         */
                        if (
                            config.zak
                        ) {

                            options.zak =
                                config.zak;

                        }


                        ZoomMtg.join(
                            options
                        );

                    },


                error:
                    function (
                        error
                    ) {

                        console.error(
                            'Zoom init error:',
                            error
                        );


                        showError(
                            'Zoom initialize nahi ho paya.'
                        );

                    },

            });


        } catch (
            error
        ) {


            console.error(
                'BhaktiDeep Zoom Error:',
                error
            );


            showError(

                error?.message
                ||
                'Zoom meeting open nahi ho payi.'

            );

        }

    }
);

</script>


</body>

</html>